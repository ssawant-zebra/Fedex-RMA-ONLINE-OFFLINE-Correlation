create or replace TEMP table `repeat_repair1` as ( 
SELECT distinct Serial_no_Out FROM `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.fedex_ground_daily_report_status`
 WHERE
cast(Serial_no_Out as STRING) IN (SELECT DISTINCT Serial_no_IN FROM `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.fedex_ground_daily_report_status`)
order by Serial_no_Out);

create or replace TEMP table `repeat_repair_in` as ( 
select report,repair_no,Ship_Date,Serial_no,zoneID,repeat_repairs from(
SELECT  report,repair_no,Ship_Date,Serial_no_In,Serial_no_Out,zoneId_serial_no_in as zoneID,
CONCAT(Serial_no_In,"-->",Serial_no_Out) as repeat_repairs,Serial_no_In as Serial_no
FROM `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.fedex_ground_daily_report_status`
 WHERE
Serial_no_In IN (SELECT DISTINCT cast(Serial_no_Out as STRING) FROM repeat_repair1)
order by Serial_no_In)order by Serial_no);

create or replace TEMP table `repeat_repair_out` as ( 
  select report,repair_no,Ship_Date,Serial_no,zoneID,repeat_repairs from(
SELECT  report,repair_no,Ship_Date ,Serial_no_In,Serial_no_Out,zoneID,CONCAT(Serial_no_In,"-->",Serial_no_Out) as repeat_repairs,
cast(Serial_no_Out as STRING)  as Serial_no
FROM `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.fedex_ground_daily_report_status`
 WHERE
cast(Serial_no_Out as STRING) IN (SELECT DISTINCT cast(Serial_no_Out as STRING) FROM repeat_repair1)
order by Serial_no_Out)order by Serial_no);


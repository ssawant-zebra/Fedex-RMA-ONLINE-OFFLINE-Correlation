create or replace TEMP table `fedex_ground_daily_report_status_a` as ( 
select b.Repair_no,b.Serial_no_In,b.Serial_no_Out,b.macAddress_final,b.Ship_Date,b.report,b.WIFI_IN,a.cluster_id,
a.site_id,a.zone,a.zoneId,a.sensorStatus,	a.errors,a.sensorMode,a.hours,a.dt as last_recorded_date_Serial_no_Out

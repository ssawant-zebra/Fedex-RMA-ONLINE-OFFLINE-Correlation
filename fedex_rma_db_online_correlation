create or replace TEMP table `data2` as ( 
select *,
case when macAddress_new is NULL then macAddress
else macAddress_new
 END AS macAddress_final
from(
select Repair_no,Serial_no_In,Serial_no_Out,macAddress,WIFI,report,WIFI_IN,Ship_Date,
case when macAddress = WIFI then WIFI
when macAddress = "1:::::" and WIFI <> "#N/A" then  WIFI
when WIFI = "#N/A" and macAddress <> "N/A" then macAddress
when WIFI <> macAddress  then macAddress
 END AS macAddress_new
from
-- `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.fedex_ground_daily_report_30092024_1`)
`dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.fedex_ground_daily_report_31122024`)
);

